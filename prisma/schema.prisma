generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  icon        String    @default("📦")
  type        String
  parentId    String?
  budgetLimit Float?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  transactions Transaction[]
  rules       RecurringRule[]
  catRules    CategorizationRule[]
  splits      TransactionSplit[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Channel {
  id          String               @id @default(cuid())
  name        String
  type        String
  balance     Float                @default(0)
  transactions Transaction[]
  rules       RecurringRule[]
  catRules    CategorizationRule[]
  transfersOut Transfer[]          @relation("TransferFrom")
  transfersIn  Transfer[]          @relation("TransferTo")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Transfer {
  id          String   @id @default(cuid())
  amount      Float
  note        String?
  fromId      String
  toId        String
  from        Channel  @relation("TransferFrom", fields: [fromId], references: [id])
  to          Channel  @relation("TransferTo", fields: [toId], references: [id])
  createdAt   DateTime @default(now())
}

model Transaction {
  id         String             @id @default(cuid())
  type       String
  amount     Float
  date       String
  note       String?
  categoryId String
  channelId  String
  projectId  String?
  category   Category           @relation(fields: [categoryId], references: [id])
  channel    Channel            @relation(fields: [channelId], references: [id])
  splits     TransactionSplit[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  categoryId    String
  amount        Float
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id])
}

model RecurringRule {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  type        String
  frequency   String
  dayOfMonth  Int      @default(1)
  nextDueDate String
  isActive    Boolean  @default(true)
  categoryId  String
  channelId   String
  category    Category @relation(fields: [categoryId], references: [id])
  channel     Channel  @relation(fields: [channelId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CategorizationRule {
  id         String   @id @default(cuid())
  keyword    String
  categoryId String
  channelId  String?
  amountMin  Float?
  amountMax  Float?
  isActive   Boolean  @default(true)
  priority   Int      @default(0)
  category   Category @relation(fields: [categoryId], references: [id])
  channel    Channel? @relation(fields: [channelId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
